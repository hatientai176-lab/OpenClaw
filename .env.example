NODE_ENV=production
HOME=/home/node

# Bắt buộc: gateway Control UI — openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Telegram (@BotFather) — nếu dùng kênh Telegram
TELEGRAM_BOT_TOKEN=

# Model (ít nhất một, tùy cấu hình agent)
OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Render HTTPS — tuỳ phiên bản OpenClaw / pairing
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=1

# Render tự inject
# PORT=
# RENDER_EXTERNAL_URL=
